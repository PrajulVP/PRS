{
    "openapi": "3.0.0",
    "info": {
        "title": "PRS API",
        "description": "API documentation for the PRS application.",
        "contact": {
            "email": "support@prs.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "API Server"
        }
    ],
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Authenticate user and get JWT token",
                "operationId": "1257f11ade1e6ee3a26cfe338badfb8e",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "superadmin@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "12345"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful login",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "access_token": {
                                            "type": "string"
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "example": "bearer"
                                        },
                                        "expires_in": {
                                            "type": "integer",
                                            "example": 3600
                                        },
                                        "user": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/profile": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Get authenticated user profile",
                "operationId": "1344face78c680406f11ca800b271f47",
                "responses": {
                    "200": {
                        "description": "User profile data"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/profile/update": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Update authenticated user profile",
                "operationId": "9f4f48f99972e2128bc191cea5a8adbe",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "address": {
                                        "type": "string",
                                        "example": "123 Main St"
                                    },
                                    "city": {
                                        "type": "string",
                                        "example": "New York"
                                    },
                                    "pincode": {
                                        "type": "string",
                                        "example": "10001"
                                    },
                                    "fathers_name": {
                                        "type": "string",
                                        "example": "Michael Doe"
                                    },
                                    "mothers_name": {
                                        "type": "string",
                                        "example": "Jane Doe"
                                    },
                                    "shop_name": {
                                        "description": "Only for retailers",
                                        "type": "string"
                                    },
                                    "gst": {
                                        "description": "For retailers and distributors",
                                        "type": "string"
                                    },
                                    "drug_license_no": {
                                        "description": "For retailers and distributors",
                                        "type": "string"
                                    },
                                    "profile_pic": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Profile updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Profile updated successfully."
                                        },
                                        "user": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Logout user and invalidate token",
                "operationId": "d0090497298d35d96a9fcde3666ff010",
                "responses": {
                    "200": {
                        "description": "Successfully logged out"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/distributors/{distributorId}/products/{productId}/availability": {
            "get": {
                "tags": [
                    "Distributors"
                ],
                "summary": "Check product availability in a distributor",
                "operationId": "8174eb162b72d81bcea9c1af13e0e0d1",
                "parameters": [
                    {
                        "name": "distributorId",
                        "in": "path",
                        "description": "Distributor ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "productId",
                        "in": "path",
                        "description": "Product ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Product availability status",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "distributor_id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "product_id": {
                                            "type": "integer",
                                            "example": 10
                                        },
                                        "available": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "stock": {
                                            "type": "integer",
                                            "example": 50
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Distributor or Product not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/distributor-orders": {
            "get": {
                "tags": [
                    "Distributor Orders"
                ],
                "summary": "List distributor orders (Unified Endpoint)",
                "description": "Returns orders for the logged-in user. If a Sales Manager, can optionally filter by distributor_id.",
                "operationId": "62124b28528742068352b1753983571e",
                "parameters": [
                    {
                        "name": "distributor_id",
                        "in": "query",
                        "description": "Filter by specific distributor (Manager/Admin only)",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "payment_status",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "from_date",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "to_date",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of orders"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Distributor Orders"
                ],
                "summary": "Place a new distributor order",
                "operationId": "2f083d52d32ebe796d33e33c29600302",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "items": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "product_id": {
                                                    "type": "integer"
                                                },
                                                "quantity": {
                                                    "type": "integer"
                                                },
                                                "unit": {
                                                    "type": "string",
                                                    "example": "Box"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Order placed successfully"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/distributor-orders/{id}": {
            "get": {
                "tags": [
                    "Distributor Orders"
                ],
                "summary": "Get details of a single distributor order",
                "operationId": "2df49f1a24a961f2774b105f9bc24e40",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Order details"
                    },
                    "404": {
                        "description": "Order not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/distributor-orders/{id}/update-status": {
            "post": {
                "tags": [
                    "Distributor Orders"
                ],
                "summary": "Update order status (Unified Action Endpoint)",
                "description": "Handles Manager Acceptance, Admin Approval, Receipt Confirmation, and Cancellations.",
                "operationId": "5a5f2c826dba20f3d22f173698afb966",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "action": {
                                        "type": "string",
                                        "enum": [
                                            "accept_manager",
                                            "approve_admin",
                                            "confirm_receipt",
                                            "request_cancellation",
                                            "approve_cancellation"
                                        ]
                                    },
                                    "payment_status": {
                                        "description": "Required for approve_admin",
                                        "type": "string",
                                        "enum": [
                                            "pending",
                                            "paid",
                                            "failed"
                                        ]
                                    },
                                    "invoice": {
                                        "description": "Optional for approve_admin",
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "cancellation_reason": {
                                        "description": "Required for request_cancellation",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Status updated successfully"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/distributor/inventory": {
            "get": {
                "tags": [
                    "Inventory"
                ],
                "summary": "Get distributor inventory (Unified Endpoint)",
                "description": "Returns inventory for the logged-in user. If a Sales Manager, can optionally filter by distributor_id.",
                "operationId": "560b8849ea450f272dc9c4c07ea2affc",
                "parameters": [
                    {
                        "name": "distributor_id",
                        "in": "query",
                        "description": "Filter by specific distributor (Manager/Admin only)",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search by product name or code",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of inventory items"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/inventory/{id}": {
            "get": {
                "tags": [
                    "Inventory"
                ],
                "summary": "Get specific inventory item",
                "operationId": "cb12f630662944c0f607dbc8f9fd14be",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Inventory ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Inventory item details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "product_id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "distributor_id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "stock": {
                                            "type": "integer",
                                            "example": 100
                                        },
                                        "distributor_product_code": {
                                            "type": "string",
                                            "example": "P001"
                                        },
                                        "product": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "product_name": {
                                                    "type": "string",
                                                    "example": "Product Name"
                                                },
                                                "product_code": {
                                                    "type": "string",
                                                    "example": "P001"
                                                },
                                                "generic_name": {
                                                    "type": "string",
                                                    "example": "Generic Name"
                                                },
                                                "mrp": {
                                                    "type": "string",
                                                    "example": "100.00"
                                                },
                                                "ptr": {
                                                    "type": "string",
                                                    "example": "80.00"
                                                },
                                                "pts": {
                                                    "type": "string",
                                                    "example": "70.00"
                                                },
                                                "gst": {
                                                    "type": "string",
                                                    "example": "12"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Inventory not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/products": {
            "get": {
                "tags": [
                    "Products"
                ],
