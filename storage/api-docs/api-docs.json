                                            },
                                            "mrp": {
                                                "type": "string",
                                                "example": "20.00"
                                            },
                                            "ptr": {
                                                "type": "string",
                                                "example": "15.00"
                                            },
                                            "pts": {
                                                "type": "string",
                                                "example": "12.00"
                                            },
                                            "gst": {
                                                "type": "string",
                                                "example": "12.00"
                                            },
                                            "net_amount": {
                                                "type": "string",
                                                "example": "18.00"
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
