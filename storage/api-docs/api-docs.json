                                                "example": "P001"
                                            },
                                            "product_name": {
                                                "type": "string",
                                                "example": "Paracetamol 500mg"
                                            },
                                            "generic_name": {
                                                "type": "string",
                                                "example": "Paracetamol"
                                            },
                                            "strip_size": {
                                                "type": "integer",
                                                "example": 10
                                            },
                                            "box_size": {
                                                "type": "integer",
